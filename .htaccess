<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>

    <FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rewrite all traffic to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
